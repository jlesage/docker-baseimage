+    assert_eq!(code, 0, "gpasswd -d should exit 0");
+
+    let group = named_line(&read_group(&dir), "devs");
+    let members = colon_fields(&group)[3];
+    assert!(
+        !members.split(',').any(|m| m == "bob"),
+        "bob should be removed from /etc/group, got: {group}"
