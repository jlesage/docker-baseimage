+#[test]
+fn test_create_user_with_key_uid_range() {
+    if common::skip_unless_root() {
+        return;
+    }
+
+    let dir = setup_root_dir();
+    let code = run_with_root(
+        &dir,
+        &[
+            "-K",
+            "UID_MIN=9100",
+            "-K",
+            "UID_MAX=9100",
+            "-M",
+            "-N",
+            "keyuser",
