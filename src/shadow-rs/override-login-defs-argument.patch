+            "-K",
+            "SYS_UID_MIN=250",
+            "-K",
+            "SYS_UID_MAX=250",
+            "-M",
+            "-N",
+            "syskeyuser",
+        ],
+    );
+    assert_eq!(code, 0, "useradd -r -K SYS_UID range should exit 0");
+
+    let passwd = read_passwd(&dir);
+    assert!(
+        passwd.contains("syskeyuser:x:250:"),
+        "passwd should contain UID 250 from -K, got: {passwd}"
+    );
+}
