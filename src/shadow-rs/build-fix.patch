#
# Disable shell completion support to allow compilation of static binary.
#
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -6,6 +6,7 @@
 edition.workspace = true
 rust-version.workspace = true
 license.workspace = true
+autobins = false
 repository.workspace = true
 homepage.workspace = true
 description = "Memory-safe Rust reimplementation of Linux shadow-utils"
@@ -47,8 +48,7 @@
 shadow-core = { path = "src/shadow-core", version = "0.2.2" }
 
 # CLI
-clap = { version = "4", features = ["derive", "wrap_help"] }
-clap_complete = "4"
+clap = { version = "4", features = ["wrap_help"] }
 
 # uutils integration
 uucore = "0.11"
@@ -71,7 +71,6 @@
 
 [dependencies]
 clap = { workspace = true }
-clap_complete = { workspace = true, optional = true }
 shadow-core = { path = "src/shadow-core", version = "0.2.2" }
 rustix = { workspace = true }
 
@@ -121,18 +120,10 @@
 # PAM authentication (requires libpam-dev)
 pam = ["passwd/pam"]
 
-# Shell completions generator
-completions = ["dep:clap_complete"]
-
 [[bin]]
 name = "shadow-rs"
 path = "src/bin/shadow-rs.rs"
 
-[[bin]]
-name = "shadow-rs-completions"
-path = "src/bin/completions.rs"
-required-features = ["completions"]
-
 [[test]]
 name = "test_chage"
 path = "tests/by-util/test_chage.rs"
--- a/Makefile
+++ b/Makefile
@@ -23,7 +23,7 @@
 	cargo build --release --workspace --bins --exclude uu_shadow --features uu_passwd/pam
 
 build-multicall:
-	cargo build --release --bin shadow-rs --features pam
+	#cargo build --release --bin shadow-rs --features pam
 
 test:
 	cargo test --workspace
@@ -32,10 +32,10 @@
 # layout matching GNU shadow-utils. Only passwd/chfn/chsh/newgrp are setuid.
 install: build
 	@for tool in $(SETUID_TOOLS); do \
-		install -Dm4755 target/release/$$tool $(DESTDIR)$(BINDIR)/$$tool || exit 1; \
+		install -Dm4755 target/$(CARGO_BUILD_TARGET)/release/$$tool $(DESTDIR)$(BINDIR)/$$tool || exit 1; \
 	done
 	@for tool in $(ROOT_TOOLS); do \
-		install -Dm0755 target/release/$$tool $(DESTDIR)$(BINDIR)/$$tool || exit 1; \
+		install -Dm0755 target/$(CARGO_BUILD_TARGET)/release/$$tool $(DESTDIR)$(BINDIR)/$$tool || exit 1; \
 	done
 	@echo "Installed $(words $(ALL_TOOLS)) standalone binaries to $(DESTDIR)$(BINDIR)/"
 	@echo "  setuid (4755): $(SETUID_TOOLS)"
@@ -46,7 +46,7 @@
 # applets run with euid=root when invoked via symlink. Intended for
 # container/embedded use where disk savings matter and attack surface does not.
 install-multicall: build-multicall
-	install -Dm4755 target/release/shadow-rs $(DESTDIR)$(BINDIR)/shadow-rs
+	install -Dm4755 target/$(CARGO_BUILD_TARGET)/release/shadow-rs $(DESTDIR)$(BINDIR)/shadow-rs
 	@for tool in $(ALL_TOOLS); do \
 		ln -sf shadow-rs $(DESTDIR)$(BINDIR)/$$tool; \
 	done
