#!/bin/sh
#
# Print the merged list of supplementary group IDs from SUP_GROUP_IDS,
# SUP_GROUP_IDS_INTERNAL and any SUP_GROUP_IDS_INTERNAL_* variables.
#
# IDs are printed one per line, unique and sorted numerically. Empty values
# and ID 0 are omitted. The primary group (GROUP_ID) is not included; callers
# that need it (e.g. the default service sgid) should add it themselves.
#

set -e # Exit immediately if a command exits with a non-zero status.
set -u # Treat unset variables as an error.

grps="${SUP_GROUP_IDS:-},${SUP_GROUP_IDS_INTERNAL:-}"

# Check the environment for SUP_GROUP_IDS_INTERNAL_* variables.
for var in $(env | sed -n 's/\(^SUP_GROUP_IDS_INTERNAL_[A-Z0-9_]\+\)\=.*/\1/p'); do
    eval "grps=\${grps},\$${var}"
done

echo "${grps}" \
    | tr ',' '\n' \
    | grep -v '^$' \
    | grep -v '^0$' \
    | sort -nub

